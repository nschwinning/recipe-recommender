# Copy to .env and fill in. All values have working defaults for local Docker.

# --- Database (docker-compose) ---
POSTGRES_USER=recipe
POSTGRES_PASSWORD=recipe
POSTGRES_DB=recipe

# --- Backend ---
# Allowed browser origin(s) for CORS (the frontend dev server).
CORS_ORIGINS=http://localhost:5175

# --- AI generation ---
# Leave OPENAI_API_KEY empty (or set RECIPE_STUB=true) to use the deterministic
# stub generator and run the whole app with no OpenAI account.
OPENAI_API_KEY=
RECIPE_MODEL=gpt-5-mini
RECIPE_STUB=
# Timezone that decides which calendar day "today's recipe" belongs to.
RECIPE_TIMEZONE=America/New_York

# --- Daily generation cron ---
# Shared secret the cron sidecar sends as X-Cron-Token. MUST be set non-empty to
# enable the scheduled daily generation; empty rejects every cron trigger.
RECIPE_CRON_TOKEN=
# When the daily recipe is generated (cron expression, in CRON_TZ).
RECIPE_SCHEDULE=5 4 * * *
CRON_TZ=America/New_York
